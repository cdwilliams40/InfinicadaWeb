{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infinicadaweb-garmin-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  // global_fetch_strictly_public is required by the OAuth provider to fetch
  // Client ID Metadata Documents safely.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Serve this Worker on a custom domain in a zone on your Cloudflare account,
  // because the Access application that protects /authorize is set up on that
  // hostname. Uncomment and set your hostname, e.g. "garmin.example.com":
  // "routes": [{ "pattern": "garmin.example.com", "custom_domain": true }],
  // The server takes its OAuth issuer from the request origin, so nothing else
  // changes. Once the custom domain works, set workers_dev to false so it is the
  // only origin; on workers.dev, /authorize already fails closed (no Access).
  // Preview URLs per version are off for the same reason.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // OAuth clients, grants and tokens, plus the cached Garmin bearer token.
  // Without an id, the first `wrangler deploy` provisions the namespace
  // ("infinicadaweb-garmin-mcp-oauth-kv") and later deploys keep using it.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "vars": {
    // "global" (connect.garmin.com) or "cn" (connect.garmin.cn)
    "GARMIN_REGION": "global",
    // IANA time zone used to resolve "today" when a date is omitted
    "TIMEZONE": "America/New_York"
  },
  // ACCESS_AUD: audience tag of the Cloudflare Access application that
  // protects /authorize.
  "secrets": {
    "required": ["GARMIN_API_KEY", "ACCESS_AUD"]
  },
  // `wrangler dev` simulates Access with this identity; set ACCESS_AUD to the
  // same aud in .env.
  "access": {
    "dev": { "aud": "local-dev", "identity": { "email": "owner@example.com" } }
  }
}
